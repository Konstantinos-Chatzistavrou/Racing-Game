@tool
extends EditorScenePostImport
## Post-import for city.glb (generated by assets_source/scripts/make_city.py). Regenerable: maps
## glTF materials/lights onto Godot features glTF can't express, and tags physics surfaces.

const ROAD_SHADER := preload("res://shaders/wet_road.gdshader")
var _road_mat: ShaderMaterial


func _post_import(scene: Node) -> Object:
	_road_mat = ShaderMaterial.new()
	_road_mat.resource_name = "road_asphalt"
	_road_mat.shader = ROAD_SHADER
	_road_mat.set_shader_parameter("albedo_tex", load("res://assets/textures/asphalt_albedo.png"))
	_road_mat.set_shader_parameter("normal_tex", load("res://assets/textures/asphalt_normal.png"))
	_road_mat.set_shader_parameter("rough_tex", load("res://assets/textures/asphalt_rough.png"))
	_road_mat.set_shader_parameter("puddle_tex", load("res://assets/textures/puddle_mask.png"))
	_walk(scene)
	return scene


func _walk(n: Node) -> void:
	if n is MeshInstance3D:
		_mesh(n)
	elif n is SpotLight3D and n.name.begins_with("lamp_light"):
		# Street lamp, fully baked (direct + bounce). ~100 W LED, 57 deg half-angle, 7 m mast.
		n.light_bake_mode = Light3D.BAKE_STATIC
		n.light_energy = 9.0
		n.spot_range = 22.0
		n.spot_attenuation = 1.2
		n.spot_angle = 57.0
		n.spot_angle_attenuation = 0.6
		n.light_size = 0.4
		n.shadow_enabled = true            # baked shadows (lightmapper only traces shadow-enabled lights)
		n.light_color = Color(1.0, 0.86, 0.68)
	elif n is OmniLight3D and n.name.begins_with("neon_light"):
		n.light_bake_mode = Light3D.BAKE_STATIC
		n.light_energy = 1.5
		n.omni_range = 8.0
		n.omni_attenuation = 1.5
		n.shadow_enabled = false
	elif n is StaticBody3D:
		for t in ["asphalt", "pavement", "wall"]:
			if String(n.name).contains("col_" + t):
				n.set_meta("surface", t)     # read by RSVehicle's wheel raycasts
	for c in n.get_children():
		_walk(c)


func _mesh(mi: MeshInstance3D) -> void:
	var nm := String(mi.name)
	mi.gi_mode = GeometryInstance3D.GI_MODE_STATIC
	for i in mi.mesh.get_surface_count():
		var m := mi.mesh.surface_get_material(i)
		if m == null:
			continue
		match m.resource_name:
			"road_asphalt":
				mi.mesh.surface_set_material(i, _road_mat)
			"facade_office", "facade_brick":
				(m as StandardMaterial3D).emission_energy_multiplier = 1.3
			"shopfront":
				(m as StandardMaterial3D).emission_energy_multiplier = 1.6
			"concrete", "road_paint":
				(m as StandardMaterial3D).texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
				(m as StandardMaterial3D).roughness = 0.35        # wet pavement / wet paint
	# Lightmap density: roads/pavements carry the lamp pools; facades are lit by their windows.
	if nm.begins_with("facade") or nm.begins_with("roof") or nm.begins_with("shop"):
		mi.gi_lightmap_texel_scale = 0.25
	elif nm.begins_with("walk"):
		mi.gi_lightmap_texel_scale = 0.6
	elif nm.begins_with("lamp") or nm.begins_with("neon") or nm.begins_with("tl_"):
		mi.gi_mode = GeometryInstance3D.GI_MODE_DISABLED     # emissive: lights itself
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	elif nm.begins_with("steel"):
		mi.gi_mode = GeometryInstance3D.GI_MODE_DYNAMIC      # thin poles: lit by lightmap probes
	if nm.begins_with("road") or nm.begins_with("paint"):
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
