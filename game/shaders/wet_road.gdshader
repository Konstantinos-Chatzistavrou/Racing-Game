// Wet night asphalt for city streets.
// Mesh UV = world position / 4 m (written by make_city.py), so textures tile in metres everywhere
// and junctions match seamlessly. Lightmaps use UV2 (generated by Godot on import).
shader_type spatial;
render_mode blend_mix, cull_back, diffuse_burley, specular_schlick_ggx;

uniform sampler2D albedo_tex : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D normal_tex : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D rough_tex : hint_default_white, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2D puddle_tex : hint_default_black, filter_linear_mipmap, repeat_enable;
uniform float wetness : hint_range(0.0, 1.0) = 0.8;

// Street-lamp reflections. Lamps are BAKED (diffuse only) into the lightmap; a lightmap cannot hold
// view-dependent specular, which is most of the "wet street" look, so it is computed here.
// Lamps are stored in a coarse 2D grid texture (one lamp per cell, RGB = position, A = present);
// each pixel only evaluates the 3x3 cells around it (9 lamps max), anywhere in the city.
uniform sampler2D lamp_grid : filter_nearest, repeat_disable;
uniform vec2 grid_origin = vec2(0.0);        // world XZ of cell (0, 0)
uniform float grid_cell = 14.0;
uniform ivec2 grid_size = ivec2(0);
uniform vec3 lamp_color : source_color = vec3(1.0, 0.86, 0.68);
uniform float lamp_intensity = 6.0;

varying vec3 world_pos;
varying vec3 world_normal;

void vertex() {
	world_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	world_normal = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
}

// Anisotropic GGX normal distribution (Burley 2012):
//   D(h) = 1 / (pi ax ay ((h.t/ax)^2 + (h.b/ay)^2 + (h.n)^2)^2)
// Water ripples scatter light mostly along the view direction -> long vertical streaks.
float d_ggx_aniso(vec3 h, vec3 n, vec3 t, vec3 b, float ax, float ay) {
	float ht = dot(h, t) / ax;
	float hb = dot(h, b) / ay;
	float hn = dot(h, n);
	float k = ht * ht + hb * hb + hn * hn;
	return 1.0 / (PI * ax * ay * k * k);
}

void fragment() {
	vec3 alb = texture(albedo_tex, UV).rgb;
	float rough = texture(rough_tex, UV).r;
	vec3 nrm = texture(normal_tex, UV).rgb;
	float puddle = smoothstep(0.35, 0.75, texture(puddle_tex, UV / 16.0).r);   // 64 m tile

	// Wetness: water fills the pores -> darker (less diffuse) and much smoother (mirror film);
	// puddles: standing water hides the stone texture.
	float wet = wetness * (0.55 + 0.45 * puddle);
	alb *= mix(1.0, 0.5, wet);
	alb *= mix(1.0, 0.6, puddle * wetness);
	rough = mix(rough, 0.12, wet * 0.85);
	rough = mix(rough, 0.03, puddle * wetness);
	nrm = mix(nrm, vec3(0.5, 0.5, 1.0), puddle * wetness * 0.9);

	vec3 n = normalize(world_normal + vec3(nrm.x - 0.5, 0.0, nrm.y - 0.5) * 0.25 * (1.0 - puddle));
	vec3 v = normalize(CAMERA_POSITION_WORLD - world_pos);
	vec3 t = normalize(v - n * dot(v, n));
	vec3 bt = cross(n, t);
	float spec_rough = mix(0.22, 0.05, wet);
	vec3 spec = vec3(0.0);
	if (grid_size.x > 0) {
		ivec2 cell = ivec2(floor((world_pos.xz - grid_origin) / grid_cell));
		for (int dy = -1; dy <= 1; dy++) {
			for (int dx = -1; dx <= 1; dx++) {
				ivec2 c = cell + ivec2(dx, dy);
				if (c.x < 0 || c.y < 0 || c.x >= grid_size.x || c.y >= grid_size.y) continue;
				vec4 lamp = texelFetch(lamp_grid, c, 0);
				if (lamp.a < 0.5) continue;
				vec3 lv = lamp.xyz - world_pos;
				float dist = length(lv);
				vec3 l = lv / dist;
				float ndl = max(dot(n, l), 0.0);
				vec3 h = normalize(l + v);
				float d = d_ggx_aniso(h, n, t, bt, spec_rough * 2.2, spec_rough * 0.6);
				float f = 0.02 + 0.98 * pow(1.0 - max(dot(v, h), 0.0), 5.0);   // Schlick, water F0 = 0.02
				float atten = 1.0 / (1.0 + dist * dist * 0.02);
				spec += lamp_color * d * f * atten * ndl / max(4.0 * ndl * max(dot(n, v), 0.05), 1e-3);
			}
		}
	}
	EMISSION = spec * lamp_intensity * (0.35 + 0.65 * wet);
	ALBEDO = alb;
	ROUGHNESS = rough;
	METALLIC = 0.0;
	SPECULAR = 0.5;
	NORMAL_MAP = nrm;
}
